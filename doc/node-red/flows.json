    {
        "id": "db026363602ae16b",
        "type": "postgresql",
        "z": "b1914b3d9178b02e",
        "name": "dash",
        "query": "WITH doses AS (\n  SELECT\n    d.paciente,\n    d.nome AS dispositivo,\n    dp.dispositivo_id,\n    dp.compartimento,\n    dp.medicamento,\n    dp.horario,\n    ((now() AT TIME ZONE 'America/Sao_Paulo')::date + dp.horario)\n      AT TIME ZONE 'America/Sao_Paulo' AS alvo,\n    make_interval(mins => dp.tolerancia_min) AS tol\n  FROM dose_programada dp\n  JOIN dispositivo d ON d.id = dp.dispositivo_id\n  WHERE dp.ativo\n)\nSELECT\n  x.paciente,\n  x.dispositivo,\n  x.compartimento,\n  x.medicamento,\n  left(x.horario::text, 5) AS horario,\n  to_char(e.ocorrido_em AT TIME ZONE 'America/Sao_Paulo', 'HH24:MI') AS retirada_em,\n  CASE\n    WHEN e.ocorrido_em IS NOT NULL THEN 'tomada'\n    WHEN now() < x.alvo - x.tol THEN 'agendada'\n    WHEN now() <= x.alvo + x.tol THEN 'aguardando'\n    ELSE 'perdida'\n  END AS status\nFROM doses x\nLEFT JOIN LATERAL (\n  SELECT ev.ocorrido_em\n  FROM evento ev\n  WHERE ev.dispositivo_id = x.dispositivo_id\n    AND ev.compartimento = x.compartimento\n    AND ev.tipo = 'retirada'\n    AND ev.ocorrido_em BETWEEN x.alvo - x.tol AND x.alvo + x.tol\n  ORDER BY ev.ocorrido_em\n  LIMIT 1\n) e ON true\nORDER BY x.horario;",
        "postgreSQLConfig": "f1438fc7824ee337",
        "split": false,
        "rowsPerMsg": "1",
        "outputs": 1,
        "x": 570,
        "y": 580,
        "wires": [
            [
                "96af2b6dfb5e66f7"
            ]
        ]
    },
