        "z": "b1914b3d9178b02e",
        "name": "function 10",
        "func": "const row = msg.payload;\nconst agora = Date.now();\nconst pend = context.get(\"pendente\");\n\n// 1º clique (ou clique em outra linha, ou fora do prazo): só pede confirmação\nif (!pend || pend.id !== row.id || agora > pend.ate) {\n  context.set(\"pendente\", { id: row.id, ate: agora + 10000 });\n  msg.payload = \"Clique em Excluir de novo em até 10 s para confirmar: \"\n              + row.medicamento + \" às \" + row.horario + \".\";\n  return [null, msg];                  // saída 2 → notification\n}\n\n// 2º clique: exclui\ncontext.set(\"pendente\", null);\nmsg.pgConfig = {\n  user: \"postgres.jbnlcdliinhlrixgzeml\",\n  password: env.get(\"SUPABASE_DB_PASSWORD\"),\n  host: \"aws-1-us-east-1.pooler.supabase.com\",\n  database: \"postgres\",\n  port: 5432,\n  ssl: { rejectUnauthorized: false }\n};\nmsg.params = [row.id];\nreturn [msg, null];                    // saída 1 → postgresql",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
