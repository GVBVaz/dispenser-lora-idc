    {
        "id": "5622040c22d22d6b",
        "type": "function",
        "z": "b1914b3d9178b02e",
        "name": "function 3",
        "func": "const f = msg.payload;\nconst comp = parseInt(f.compartimento, 10);\nconst tol = (f.tolerancia_min === \"\" || f.tolerancia_min == null)\n    ? 30 : parseInt(f.tolerancia_min, 10);\n\nif (!f.dispositivo_id || !f.horario || !f.medicamento || !(comp >= 1) || !(tol >= 0)) {\n    msg.payload = \"Preencha todos os campos corretamente.\";\n    return [null, msg];            // saída 2: aviso de erro\n}\n\nmsg.params = [f.dispositivo_id, comp, f.medicamento.trim(), f.horario, tol];\nreturn [msg, null];              // saída 1: segue para o banco",
